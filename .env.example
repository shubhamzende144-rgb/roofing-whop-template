# Public IDs, baked into the browser bundle at build time. setup.sh writes .env for you.
VITE_WHOP_ENVIRONMENT=production
VITE_WHOP_COMPANY_ID=biz_REPLACE_ME
VITE_WHOP_PLAN_INSPECTION=plan_REPLACE_ME
VITE_WHOP_PLAN_FLAT_RATE=plan_REPLACE_ME
VITE_WHOP_PLAN_DEPOSIT=plan_REPLACE_ME

# Server secrets are NOT kept in files. setup.sh stores them on the app with
# `whop apps secrets set`: ROOFING_API_KEY, WHOP_COMPANY_ID, ROOFING_PRODUCT_ID, ADMIN_TOKEN
