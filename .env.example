# ── Server-only (never prefix these with VITE_) ─────────────────────────────
# "sandbox" for test checkouts (keys from sandbox.whop.com/dashboard/developer), else "production".
WHOP_ENVIRONMENT=sandbox
# Account API key. Needs: lead create, payment:charge, invoice:create, plan:create.
WHOP_API_KEY=
# The business (biz_...) that owns leads, payments, and invoices.
WHOP_COMPANY_ID=biz_REPLACE_ME
# Product (prod_...) that final-balance invoices are billed under.
WHOP_FINAL_BALANCE_PRODUCT_ID=prod_REPLACE_ME
# Optional: product (prod_...) to attach estimate-form leads to.
WHOP_LEAD_PRODUCT_ID=
# Long random string. Required to call /api/final-invoice from the /admin page.
ADMIN_TOKEN=

# ── Public (safe in the browser) ──────────────────────────────────────────────
VITE_WHOP_ENVIRONMENT=sandbox
VITE_WHOP_COMPANY_ID=biz_REPLACE_ME
VITE_WHOP_PLAN_INSPECTION=plan_REPLACE_ME
VITE_WHOP_PLAN_DEPOSIT=plan_REPLACE_ME
VITE_WHOP_PLAN_FLAT_RATE=plan_REPLACE_ME
